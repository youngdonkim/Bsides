---
import type { CollectionEntry } from 'astro:content';
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const d = note.data;
const slug = note.id;
---
<a
  href={`/notes/${slug}`}
  data-note-step={d.num}
  style="display: grid; grid-template-columns: 56px 1fr auto; gap: 16px; align-items: start; padding: 18px 22px; border-radius: var(--b-r-14); border: 1px solid var(--b-line); background: var(--b-card); transition: background 160ms, border-color 160ms; color: inherit; text-decoration: none;"
>
  <span style="font-family: var(--b-font-hand); font-size: 32px; color: var(--b-olive); line-height: 1;">{d.num}</span>
  <div>
    <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
      <span class="t-caption" style="color: var(--b-olive); text-transform: uppercase; letter-spacing: 0.08px; font-weight: 600;">{d.en}</span>
      <span class="t-title-3" style="color: var(--b-ink);">{d.ko}</span>
    </div>
    <div class="t-body" style="font-size: 14px; line-height: 1.55; color: var(--b-ink-soft); margin: 0;">{d.lead}</div>
  </div>
  <span
    data-read-badge
    style="display: none; align-items: center; gap: 4px; padding: 4px 10px; background: var(--b-olive-soft); color: var(--b-olive-deep); border-radius: var(--b-r-pill); font-size: 12px; font-weight: 600; height: fit-content; margin-top: 6px;"
  >✓ 읽음</span>
</a>
