---
import type { CurrentMember } from '../../data/current-member';

interface Props {
  member: CurrentMember;
}

const { member } = Astro.props;
const isActive = member.cycle_state === 'active';

function formatWorkshop(iso: string | null): string {
  if (!iso) return '';
  const d = new Date(iso);
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  const dayNames = ['일', '월', '화', '수', '목', '금', '토'];
  const day = dayNames[d.getDay()];
  const hh = String(d.getHours()).padStart(2, '0');
  const min = String(d.getMinutes()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd} (${day}) ${hh}:${min}`;
}
---
{isActive ? (
  <section style="padding: 32px 0px 56px;">
    <div class="b-container">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; flex-wrap: wrap;">
        <div>
          <div style="font-size: 12px; font-weight: 500; letter-spacing: 0.08px; color: var(--b-olive); text-transform: uppercase; margin-bottom: 8px;">Now running</div>
          <h2 class="t-title-1" style="color: var(--b-ink);">이번 사이클 멤버</h2>
        </div>
      </div>
      <div style="background: var(--b-card); border: 1px solid var(--b-line); border-radius: var(--b-r-20); padding: 0px; box-shadow: var(--b-shadow-1); transform: none; transition: 200ms cubic-bezier(0.2, 0, 0, 1); cursor: default; overflow: hidden;">
        <div class="b-mentor-grid">
          <div style="padding: 32px 36px 36px; display: flex; flex-direction: column; gap: 18px;">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 10px; background: var(--b-live-soft); border-radius: var(--b-r-pill); font-size: 13px; font-weight: 600; color: rgb(124, 58, 31); white-space: nowrap;">
                <span class="b-live-dot"></span>{member.live_pill_label}
              </span>
              <span class="t-caption" style="white-space: nowrap;">{member.progress_label}</span>
            </div>
            <h3 class="t-title-1" style="color: var(--b-ink); line-height: 1.25;">{member.project_title}</h3>
            <div style="display: grid; grid-template-columns: auto 1fr; gap: 10px 18px; margin-top: 8px; font-size: 14.5px;">
              <span class="t-label" style="color: var(--b-ink-faint);">멤버</span>
              <span style="color: var(--b-ink); font-weight: 500;">{member.member_name} · {member.member_kind}</span>
              <span class="t-label" style="color: var(--b-ink-faint);">학습자료</span>
              <span style="color: var(--b-ink);">{member.curriculum}</span>
              <span class="t-label" style="color: var(--b-ink-faint);">진행 회차</span>
              <span style="color: var(--b-ink);">{member.progress_label}</span>
              <span class="t-label" style="color: var(--b-ink-faint);">다음 워크샵</span>
              <span style="color: var(--b-ink);">{formatWorkshop(member.next_workshop_at)} · {member.next_workshop_format}</span>
            </div>
            {member.current_round_slug && (
              <div style="margin-top: 8px;">
                <a href={`/progress/${member.current_round_slug}`} style="font-size: 14px; font-weight: 500; color: var(--b-olive); border-bottom: 1px solid var(--b-olive-line); padding-bottom: 2px;">이번 회차 진행상황 보기 →</a>
              </div>
            )}
          </div>
          <div style="background: var(--b-paper-deep); border-left: 1px solid var(--b-line); padding: 28px; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden;">
            <div style="aspect-ratio: 1 / 1; background: linear-gradient(135deg, rgb(205, 208, 166) 0%, rgb(185, 192, 148) 100%); border-radius: var(--b-r-12); position: relative; overflow: hidden; transform: none; width: 85%;">
              <div class="b-cover-shade"></div>
              <div class="b-cover-caption">cover sketch</div>
            </div>
            <div class="b-sticky-note b-sticky-note--yellow b-sticky-note--sm" style="transform: rotate(4deg); position: absolute; bottom: 18px; right: 18px; width: 140px;">{member.member_name}님 프로젝트<br>{member.progress_label}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section style="padding: 32px 0px 56px;">
    <div class="b-container">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; flex-wrap: wrap;">
        <div>
          <div style="font-size: 12px; font-weight: 500; letter-spacing: 0.08px; color: var(--b-olive); text-transform: uppercase; margin-bottom: 8px;">Between cycles</div>
          <h2 class="t-title-1" style="color: var(--b-ink);">다음 회차 준비 중</h2>
        </div>
      </div>
      <div style="background: var(--b-card); border: 1px solid var(--b-line); border-radius: var(--b-r-20); padding: 0px; box-shadow: var(--b-shadow-1); overflow: hidden;">
        <div class="b-mentor-grid">
          <div style="padding: 32px 36px 36px; display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 10px; background: var(--b-paper-deep); border-radius: var(--b-r-pill); font-size: 13px; font-weight: 600; color: var(--b-ink-soft); white-space: nowrap;">
                <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--b-ink-faint);"></span>다음 사이클 모집 중
              </span>
            </div>
            <h3 class="t-title-1" style="color: var(--b-ink); line-height: 1.25;">다음 회차 주인공을 모십니다</h3>
            <p class="t-body" style="font-size: 15.5px; line-height: 1.6; color: var(--b-ink-soft); margin: 0;">한 사이클이 막 끝났어요. 다음 사이클의 주인공이 될 멤버를 모시는 중이에요. 객원 멤버로 먼저 합류하면 다음 사이클의 분위기를 미리 느껴볼 수 있어요.</p>
            <div style="margin-top: 4px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
              <a class="b-btn-primary b-btn-primary--sm" href="/#apply">객원 멤버로 사전 신청 <span aria-hidden="true">→</span></a>
              <a href="/progress" style="font-size: 14px; font-weight: 500; color: var(--b-olive); border-bottom: 1px solid var(--b-olive-line); padding-bottom: 2px;">지난 회차 둘러보기 →</a>
            </div>
          </div>
          <div style="background: var(--b-paper-deep); border-left: 1px solid var(--b-line); padding: 28px; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden;">
            <img src="/assets/spooni/waiting.svg" alt="Bsides 마스코트 스푼이 — 다음 회차를 기다리는 포즈" width="160" height="140" loading="lazy" style="display:block; transform: rotate(-3deg);" />
            <div class="b-sticky-note b-sticky-note--mint b-sticky-note--sm" style="transform: rotate(4deg); position: absolute; bottom: 18px; right: 18px; width: 140px;">다음 회차<br>준비 중</div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
